<Window x:Class="TRPOLARIS.NFSU2.WebControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TRPOLARIS NFSU2 Web Control Center v1.5.6"
        Icon="{StaticResource AppIconDrawing}"
        Width="1420" Height="920" MinWidth="1060" MinHeight="700"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions><RowDefinition Height="38"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <Border x:Name="WindowTitleBar" Grid.Row="0" Background="#090E14" BorderBrush="#2B3B49" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="WindowTitleBar_MouseLeftButtonDown">
            <Grid Margin="14,0,4,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Image Source="{StaticResource AppIconDrawing}" Width="23" Height="23" Stretch="Uniform" Margin="0,0,9,0"/>
                    <TextBlock Text="TRPOLARIS" FontSize="11" FontWeight="Bold" Foreground="#F1F6FF" VerticalAlignment="Center"/>
                    <TextBlock Text="  /  NFSU2 WEB CONTROL CENTER" FontSize="10" FontWeight="SemiBold" Foreground="#97A6B5" VerticalAlignment="Center"/>
                    <TextBlock Text="  ·  v1.5.6" FontSize="9" FontWeight="SemiBold" Foreground="#1BCBC3" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MinimizeWindowButton" Content="—" Style="{StaticResource WindowCaptionButton}" Click="MinimizeWindow_Click" ToolTip="Simge durumuna küçült"/>
                    <Button x:Name="MaximizeWindowButton" Content="□" Style="{StaticResource WindowCaptionButton}" Click="MaximizeWindow_Click" ToolTip="Büyüt / geri yükle"/>
                    <Button x:Name="CloseWindowButton" Content="×" Style="{StaticResource WindowCloseButton}" Click="CloseWindow_Click" ToolTip="Kapat"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions><ColumnDefinition Width="236"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource SidebarBrush}" BorderBrush="#263642" BorderThickness="0,0,1,0">
            <Grid Margin="18,22,18,16">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="0,0,0,28">
                    <Grid Height="64">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Image Source="{StaticResource AppIconDrawing}" Width="40" Height="40" Stretch="Uniform" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                            <TextBlock Text="TRPOLARIS" FontSize="19" FontWeight="Bold" Foreground="#EEF2F6">
                                <TextBlock.Effect><DropShadowEffect Color="#1BCBC3" BlurRadius="12" ShadowDepth="0"/></TextBlock.Effect>
                            </TextBlock>
                            <TextBlock Text="NFSU2 WEB" FontSize="9" FontWeight="Bold" Foreground="#1BCBC3" Margin="1,1,0,0"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock Text="WEB SERVER CONTROL" Style="{StaticResource Eyebrow}" Margin="2,8,0,0"/>
                    <TextBlock Text="Kontrol Merkezi" FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="2,5,0,0"/>
                </StackPanel>
                <TextBlock Grid.Row="1" Text="ÇALIŞMA ALANI" Style="{StaticResource Eyebrow}" Foreground="#5BAEAA" Margin="2,0,0,10"/>
                <StackPanel Grid.Row="2">
                    <Button x:Name="NavDashboard" Tag="Dashboard" Click="Navigation_Click" Style="{StaticResource NavButton}" Content="◈   Genel Bakış"/>
                    <Button x:Name="NavServer" Tag="Server" Click="Navigation_Click" Style="{StaticResource NavButton}" Content="▣   Sunucu Yönetimi"/>
                    <Button x:Name="NavFiles" Tag="Files" Click="Navigation_Click" Style="{StaticResource NavButton}" Content="▤   Dosya Yöneticisi"/>
                    <Button x:Name="NavInstall" Tag="Install" Click="Navigation_Click" Style="{StaticResource NavButton}" Content="⬇   Tek Tık Kurulum"/>
                    <Button x:Name="NavAccess" Tag="Access" Click="Navigation_Click" Style="{StaticResource NavButton}" Content="◎   Erişim ve Paylaşım"/>
                    <Button x:Name="NavDiagnostics" Tag="Diagnostics" Click="Navigation_Click" Style="{StaticResource NavButton}" Content="⌁   Tanılama ve Bakım"/>
                    <Button x:Name="NavUninstall" Tag="Uninstall" Click="Navigation_Click" Style="{StaticResource NavButton}" Content="▱   Kaldırma Merkezi"/>
                    <Button x:Name="NavLogs" Tag="Logs" Click="Navigation_Click" Style="{StaticResource NavButton}" Content="≋   Canlı İşlem Günlüğü"/>
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="0,18,0,0">
                    <Border Height="1" Background="#31424F" Margin="0,0,0,13"/>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="WslIndicator" Width="8" Height="8" Fill="{StaticResource WarningBrush}" Margin="2,0,8,0"/>
                        <TextBlock x:Name="WslSidebarText" Text="WSL DURUMU DENETLENİYOR" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                    <TextBlock Text="Tarayıcıdan oynanan sunucu" FontSize="10" Foreground="#8798A3" Margin="2,12,0,2"/>
                    <TextBlock Text="Control Center  ·  .NET 10" FontSize="10" Foreground="#8798A3" Margin="2,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions><RowDefinition Height="84"/><RowDefinition Height="*"/><RowDefinition Height="58"/><RowDefinition Height="34"/></Grid.RowDefinitions>
            <Border Grid.Row="0" Background="#0C131B" BorderBrush="#2B3B49" BorderThickness="0,0,0,1">
                <Grid Margin="28,0,30,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="TopEyebrow" Text="SUNUCU YÖNETİMİ / GENEL BAKIŞ" Style="{StaticResource Eyebrow}" Foreground="#A8B5BD"/>
                        <TextBlock x:Name="TopTitle" Text="Kontrol Merkezi" FontSize="22" FontWeight="SemiBold" Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="#192630" BorderBrush="#364A55" BorderThickness="1" CornerRadius="18" Padding="13,8" Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="WslTopDot" Width="7" Height="7" Fill="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBlock x:Name="WslTopText" Text="WSL DENETLENİYOR" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
                            </StackPanel>
                        </Border>
                        <Button Content="↻  Durumu yenile" Click="RefreshStatus_Click" Style="{StaticResource SecondaryButton}" Padding="13,8"/>
                    </StackPanel>
                </Grid>
            </Border>
            <ContentControl x:Name="PageHost" Grid.Row="1" Margin="26,24,26,22"/>
            <Border x:Name="OperationProgressPanel" Grid.Row="2" Visibility="Collapsed" Background="#0D1A22" BorderBrush="#25434A" BorderThickness="0,1,0,1" Padding="26,5">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="7"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,3">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="OperationProgressErrorCode" Visibility="Collapsed" FontSize="9" FontWeight="SemiBold" Margin="0,0,14,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OperationProgressPercent" Text="~0%" FontSize="10" FontWeight="Bold" Foreground="#65E8E1" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="OperationProgressStatus" Text="HAZIR" FontSize="9" FontWeight="Bold" Foreground="#65E8E1" Margin="0,0,10,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="OperationProgressLabel" Text="İşlem bekleniyor" FontSize="10" Foreground="#AAB7C4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                    <ProgressBar x:Name="OperationProgressBar" Grid.Row="1" Minimum="0" Maximum="100" Value="0" Height="6" BorderThickness="0" Background="#263442" Foreground="#1BCBC3"/>
                    <TextBlock x:Name="OperationProgressHint" Grid.Row="2" Text="Yüzde: indirme baytlarından ölçülen veya işlem aşamasına göre tahmin edilen toplam ilerleme." FontSize="8" Foreground="#8999A9" Margin="0,3,0,0"/>
                </Grid>
            </Border>
            <Border Grid.Row="3" Background="#0C131B" BorderBrush="#2B3B49" BorderThickness="0,1,0,0">
                <Grid Margin="28,0,28,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="TRPOLARIS  /  NFSU2 WEB SERVER" Foreground="#8999A9" FontSize="9" VerticalAlignment="Center"/>
                    <TextBlock x:Name="FooterStatus" Grid.Column="1" Text="Hazır" Foreground="{StaticResource MutedBrush}" FontSize="9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="790"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </Grid>
</Window>
