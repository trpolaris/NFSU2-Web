<Window x:Class="TRPOLARIS.NFSU2.WebControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="TRPOLARIS NFSU2 Web Control Center v1.5.6"
        Icon="{StaticResource AppIconDrawing}"
        Width="1480" Height="920" MinWidth="1120" MinHeight="720"
        WindowStyle="None" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource AppBackground}"
        FontFamily="Segoe UI" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <!-- Native DWM frame handling keeps resize edges clean; the title area remains custom. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="36" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="6"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Border Background="{StaticResource AppBackground}" BorderBrush="#30414E"
            BorderThickness="1" CornerRadius="6" ClipToBounds="True"
            SnapsToDevicePixels="True">
    <Grid Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Custom Windows title bar -->
        <Border x:Name="WindowTitleBar" Grid.Row="0" Background="#111B25"
                BorderBrush="#2B3B48" BorderThickness="0,0,0,1">
            <Grid Margin="14,0,5,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Image Source="{StaticResource AppIconDrawing}" Width="20" Height="20" Stretch="Uniform" Margin="0,0,8,0" />
                    <TextBlock Text="TRPOLARIS" FontSize="10" FontWeight="Bold" Foreground="#E8EEF3" VerticalAlignment="Center" />
                    <TextBlock Text="  /  NFSU2 WEB CONTROL CENTER" FontSize="9" FontWeight="SemiBold" Foreground="#91A0AE" VerticalAlignment="Center" />
                    <TextBlock Text="  ·  v1.5.6" FontSize="9" FontWeight="SemiBold" Foreground="#65CFC6" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="MinimizeWindowButton" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource WindowCaptionButton}"
                            Click="MinimizeWindow_Click" ToolTip="Simge durumuna küçült"
                            AutomationProperties.Name="Simge durumuna küçült">
                        <Path Data="M2,7 L10,7" Width="12" Height="12" Stretch="None"
                              Stroke="#D4DEE6" StrokeThickness="1.35" StrokeStartLineCap="Square"
                              StrokeEndLineCap="Square" SnapsToDevicePixels="True" />
                    </Button>
                    <Button x:Name="MaximizeWindowButton" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource WindowCaptionButton}"
                            Click="MaximizeWindow_Click" ToolTip="Büyüt / geri yükle"
                            AutomationProperties.Name="Büyüt veya geri yükle">
                        <Path x:Name="MaximizeWindowGlyph" Data="M2,2 H10 V10 H2 Z"
                              Width="12" Height="12" Stretch="None" Stroke="#D4DEE6"
                              StrokeThickness="1.2" StrokeLineJoin="Miter" Fill="Transparent"
                              SnapsToDevicePixels="True" />
                    </Button>
                    <Button x:Name="CloseWindowButton" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Style="{StaticResource WindowCloseButton}"
                            Click="CloseWindow_Click" ToolTip="Kapat"
                            AutomationProperties.Name="Kapat">
                        <Path Data="M2,2 L10,10 M10,2 L2,10" Width="12" Height="12" Stretch="None"
                              Stroke="#D4DEE6" StrokeThickness="1.35" StrokeStartLineCap="Square"
                              StrokeEndLineCap="Square" SnapsToDevicePixels="True" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Persistent navigation rail -->
            <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
                    BorderBrush="#263541" BorderThickness="0,0,1,0">
                <Grid Margin="14,17,13,13">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,24">
                        <Grid Height="48">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="36" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{StaticResource AppIconDrawing}" Width="32" Height="32" Stretch="Uniform" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="TRPOLARIS" FontSize="15" FontWeight="Bold" Foreground="#E8EEF3" />
                                <TextBlock Text="NFSU2 WEB" FontSize="8" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>
                        <TextBlock Text="SERVER CONTROL" Style="{StaticResource Eyebrow}" Margin="1,12,0,0" />
                        <TextBlock Text="Kontrol Merkezi" FontSize="10" Foreground="{StaticResource MutedBrush}" Margin="1,4,0,0" />
                    </StackPanel>

                    <TextBlock Grid.Row="1" Text="ÇALIŞMA ALANI" Style="{StaticResource Eyebrow}"
                               Foreground="#7EAAA8" Margin="1,0,0,8" />

                    <StackPanel Grid.Row="2">
                        <Button x:Name="NavDashboard" Tag="Dashboard" Click="Navigation_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" Foreground="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}" VerticalAlignment="Center" />
                                <TextBlock Text="Genel Bakış" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavServer" Tag="Server" Click="Navigation_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE839;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="Sunucu Yönetimi" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavFiles" Tag="Files" Click="Navigation_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="Dosya Yöneticisi" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavInstall" Tag="Install" Click="Navigation_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="Tek Tık Kurulum" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavAccess" Tag="Access" Click="Navigation_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE774;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="Erişim ve Paylaşım" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavDiagnostics" Tag="Diagnostics" Click="Navigation_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="Tanılama ve Bakım" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavUninstall" Tag="Uninstall" Click="Navigation_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="Kaldırma Merkezi" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="NavLogs" Tag="Logs" Click="Navigation_Click" Style="{StaticResource NavButton}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets" FontSize="13" Width="24" VerticalAlignment="Center" />
                                <TextBlock Text="Canlı İşlem Günlüğü" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Row="3" Margin="0,14,0,0">
                        <Border Height="1" Background="#293A46" Margin="0,0,0,11" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse x:Name="WslIndicator" Width="7" Height="7" Fill="{StaticResource WarningBrush}" Margin="1,0,8,0" />
                            <TextBlock x:Name="WslSidebarText" Text="WSL DURUMU DENETLENİYOR" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <TextBlock Text="Tarayıcı tabanlı oyun sunucusu" FontSize="9" Foreground="#7F8F9D" Margin="1,9,0,2" />
                        <TextBlock Text="Control Center  ·  .NET 10" FontSize="9" Foreground="#7F8F9D" Margin="1,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main workspace -->
            <Grid Grid.Column="1" Background="{StaticResource AppBackground}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="70" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="28" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#101923" BorderBrush="#263541" BorderThickness="0,0,0,1">
                    <Grid Margin="22,0,22,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TopEyebrow" Text="SUNUCU YÖNETİMİ / GENEL BAKIŞ"
                                       Style="{StaticResource Eyebrow}" Foreground="#91A1AE" />
                            <TextBlock x:Name="TopTitle" Text="Kontrol Merkezi" FontSize="20"
                                       FontWeight="SemiBold" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Background="#17252D" BorderBrush="#30434D" BorderThickness="1"
                                    CornerRadius="6" Padding="10,7" Margin="0,0,9,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="WslTopDot" Width="7" Height="7" Fill="{StaticResource WarningBrush}"
                                             VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock x:Name="WslTopText" Text="WSL DENETLENİYOR" FontSize="9"
                                               FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}" />
                                </StackPanel>
                            </Border>
                            <Button Content="↻  Durumu yenile"
                                    Click="RefreshStatus_Click" Style="{StaticResource SecondaryButton}"
                                    Padding="11,7" MinHeight="31" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl x:Name="PageHost" Grid.Row="1" Margin="20,18,20,16" />

                <Border x:Name="OperationProgressPanel" Grid.Row="2" Visibility="Collapsed"
                        Background="#111F28" BorderBrush="#2A454B" BorderThickness="0,1,0,1" Padding="20,6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="6" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,4">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="OperationProgressErrorCode" Visibility="Collapsed" FontSize="9"
                                           FontWeight="SemiBold" Margin="0,0,12,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="OperationProgressPercent" Text="~0%" FontSize="10"
                                           FontWeight="Bold" Foreground="#55CDC5" VerticalAlignment="Center" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="OperationProgressStatus" Text="HAZIR" FontSize="9"
                                           FontWeight="Bold" Foreground="#55CDC5" Margin="0,0,9,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="OperationProgressLabel" Text="İşlem bekleniyor" FontSize="10"
                                           Foreground="#AAB7C1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DockPanel>
                        <ProgressBar x:Name="OperationProgressBar" Grid.Row="1" Minimum="0" Maximum="100" Value="0"
                                     Height="5" BorderThickness="0" Background="#2A3945" Foreground="{StaticResource AccentBrush}" />
                        <TextBlock x:Name="OperationProgressHint" Grid.Row="2"
                                   Text="İşlem durumu ve ilerleme ayrıntıları." FontSize="8"
                                   Foreground="#82919D" Margin="0,4,0,0" />
                    </Grid>
                </Border>

                <Border Grid.Row="3" Background="#0E161F" BorderBrush="#263541" BorderThickness="0,1,0,0">
                    <Grid Margin="20,0,20,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="TRPOLARIS  /  NFSU2 WEB SERVER" Foreground="#82919D"
                                   FontSize="8" VerticalAlignment="Center" />
                        <TextBlock x:Name="FooterStatus" Grid.Column="1" Text="Hazır"
                                   Foreground="{StaticResource MutedBrush}" FontSize="8"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="720" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
    </Border>
</Window>
