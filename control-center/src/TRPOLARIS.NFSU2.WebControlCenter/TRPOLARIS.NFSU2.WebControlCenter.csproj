<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\TRPOLARIS-NFSU2.ico</ApplicationIcon>
    <AssemblyName>TRPOLARIS.NFSU2.WebControlCenter</AssemblyName>
    <RootNamespace>TRPOLARIS.NFSU2.WebControlCenter</RootNamespace>
    <Version>1.5.6</Version>
    <Product>TRPOLARIS NFSU2 Web Server Control Center</Product>
    <Authors>TRPOLARIS</Authors>
    <Description>Native WPF control center for the browser-playable Need for Speed Underground 2 web server.</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\NFSU2-Windows-OneClick-Installer.ps1" LogicalName="TRPOLARIS.NFSU2.WebControlCenter.Resources.NFSU2-Windows-OneClick-Installer.ps1" />
    <EmbeddedResource Include="Resources\nfsu2-access.sh" LogicalName="TRPOLARIS.NFSU2.WebControlCenter.Resources.nfsu2-access.sh" />
    <EmbeddedResource Include="Resources\nfsu2-project-lookup.sh" LogicalName="TRPOLARIS.NFSU2.WebControlCenter.Resources.nfsu2-project-lookup.sh" />
    <EmbeddedResource Include="Resources\nfsu2-git-update.sh" LogicalName="TRPOLARIS.NFSU2.WebControlCenter.Resources.nfsu2-git-update.sh" />
  </ItemGroup>
</Project>
